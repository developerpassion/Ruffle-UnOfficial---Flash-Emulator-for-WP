<?xml version="1.0" encoding="utf-8"?>
<!-- Windows Phone Runtime Component (C++/CX) cho WP 8.0: bọc lõi Rust, được app C# RuffleWP80 gọi.
     Mở bằng VS2015 (ruffleWP8\RuffleWP80.sln), toolset v110_wp80 (VS2012 WPSDK\WP80). -->
<Project DefaultTargets="Build" ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM"><Configuration>Debug</Configuration><Platform>ARM</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM"><Configuration>Release</Configuration><Platform>ARM</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{4A7E2C93-1D5B-4E68-B0F2-6C8D3A9E1B52}</ProjectGuid>
    <RootNamespace>RuffleWP80Native</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>11.0</MinimumVisualStudioVersion>
    <WinMDAssembly>true</WinMDAssembly>
  </PropertyGroup>
  <!-- WP 8.0 dùng VCTargetsPath11 (V110) -->
  <PropertyGroup Condition="'$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &gt;= '11.0'">
    <VCTargetsPath Condition="'$(VCTargetsPath11)' != '' and '$(VSVersion)' == '' and '$(VisualStudioVersion)' == ''">$(VCTargetsPath11)</VCTargetsPath>
  </PropertyGroup>
  <PropertyGroup>
    <TargetPlatformIdentifier>Windows Phone</TargetPlatformIdentifier>
    <TargetPlatformVersion>8.0</TargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v110_wp80</PlatformToolset>
    <!-- Debug vẫn dùng CRT release: máy WP 8.0 không có MSVCR110D/MSVCP110D/vccorlib110d -> FileNotFoundException -->
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">false</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <RuffleUwpRoot>$(MSBuildThisFileDirectory)..\..\..\ruffleUWP\</RuffleUwpRoot>
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAsWinRT>true</CompileAsWinRT>
      <PreprocessorDefinitions>_WINRT_DLL;RUFFLE_WP80;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <Optimization Condition="'$(Configuration)'=='Debug'">Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Release'">NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(RuffleUwpRoot)include;$(ProjectDir);$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalUsingDirectories>$(WindowsSDK_MetadataPath);$(AdditionalUsingDirectories)</AdditionalUsingDirectories>
      <DisableSpecificWarnings>4453;28204</DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <IgnoreAllDefaultLibraries>false</IgnoreAllDefaultLibraries>
      <IgnoreSpecificDefaultLibraries>ole32.lib;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
      <GenerateWindowsMetadata>true</GenerateWindowsMetadata>
      <AdditionalLibraryDirectories>$(RuffleUwpRoot)lib\ARM\release;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>ruffle_uwp.lib;ntdll_uwp.lib;ws2_32.lib;d3d11.lib;xaudio2.lib;WindowsPhoneCore.lib;RuntimeObject.lib;PhoneAppModelHost.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <!-- Shader GPU renderer dùng chung với ruffleUWP -> header byte array g_<tên> trong $(IntDir)Shaders -->
    <FxCompile>
      <ShaderModel>4.0_level_9_1</ShaderModel>
      <ObjectFileOutput></ObjectFileOutput>
      <HeaderFileOutput>$(IntDir)Shaders\%(Filename).h</HeaderFileOutput>
      <VariableName>g_%(Filename)</VariableName>
    </FxCompile>
  </ItemDefinitionGroup>
  <!-- Bản chẩn đoán: msbuild /p:Probe=true -> không link lõi Rust, chỉ chạy RuffleTest::Probe() -->
  <ItemDefinitionGroup Condition="'$(Probe)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>RUFFLE_PROBE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>d3d11.lib;WindowsPhoneCore.lib;RuntimeObject.lib;PhoneAppModelHost.lib</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <Reference Include="Windows"><IsWinMDFile>true</IsWinMDFile></Reference>
    <Reference Include="platform.winmd"><IsWinMDFile>true</IsWinMDFile><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="RuffleTest.h" />
    <ClInclude Include="RufflePlayer80.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="RuffleTest.cpp" />
    <ClCompile Include="RufflePlayer80.cpp" Condition="'$(Probe)'!='true'" />
    <ClCompile Include="GpuRenderer.cpp" Condition="'$(Probe)'!='true'" />
    <ClCompile Include="AudioOutput.cpp" Condition="'$(Probe)'!='true'" />
    <ClInclude Include="AudioOutput.h" />
    <ClInclude Include="GpuRenderer.h" />
  </ItemGroup>
  <ItemGroup Condition="'$(Probe)'!='true'">
    <None Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\Common.hlsli" />
    <FxCompile Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\VS.hlsl"><ShaderType>Vertex</ShaderType></FxCompile>
    <FxCompile Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\PS_Color.hlsl"><ShaderType>Pixel</ShaderType></FxCompile>
    <FxCompile Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\PS_Linear.hlsl"><ShaderType>Pixel</ShaderType></FxCompile>
    <FxCompile Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\PS_Radial.hlsl"><ShaderType>Pixel</ShaderType></FxCompile>
    <FxCompile Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\PS_Focal.hlsl"><ShaderType>Pixel</ShaderType></FxCompile>
    <FxCompile Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\PS_Bitmap.hlsl"><ShaderType>Pixel</ShaderType></FxCompile>
    <FxCompile Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\PS_Layer.hlsl"><ShaderType>Pixel</ShaderType></FxCompile>
    <FxCompile Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\PS_LayerMask.hlsl"><ShaderType>Pixel</ShaderType></FxCompile>
    <!-- Hàm Win32 Rust std cần + bù CRT VS2012 (toán C99, Fls*) — xem ruffleWP8\PROGRESS.md -->
    <ClCompile Include="..\..\shim\WpStubs.cpp" Condition="'$(Probe)'!='true'" />
    <ClCompile Include="..\..\shim\WpCompat80.cpp" Condition="'$(Probe)'!='true'"><CompileAsWinRT>false</CompileAsWinRT></ClCompile>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsPhone\v$(TargetPlatformVersion)\Microsoft.Cpp.WindowsPhone.$(TargetPlatformVersion).targets" />
</Project>
