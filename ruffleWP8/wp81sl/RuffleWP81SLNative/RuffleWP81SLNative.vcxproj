<?xml version="1.0" encoding="utf-8"?>
<!-- Windows Phone Runtime Component (C++/CX) cho app Silverlight 8.1. Dùng chung mã nguồn với wp80\RuffleWP80Native.
     Tên output giữ "RuffleWP80Native" (= namespace trong mã) để file .winmd khớp và mã C# dùng chung không phải đổi. -->
<Project DefaultTargets="Build" ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM"><Configuration>Debug</Configuration><Platform>ARM</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM"><Configuration>Release</Configuration><Platform>ARM</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{7B3F1E84-2C6A-4D95-A1E7-5F9C2B8D4A63}</ProjectGuid>
    <RootNamespace>RuffleWP80Native</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>12.0</MinimumVisualStudioVersion>
    <AppContainerApplication>true</AppContainerApplication>
    <ApplicationType>Windows Phone Silverlight</ApplicationType>
    <ApplicationTypeRevision>8.1</ApplicationTypeRevision>
    <WinMDAssembly>true</WinMDAssembly>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v120</PlatformToolset>
    <!-- Máy không có CRT debug -> Debug cũng dùng CRT release -->
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>RuffleWP80Native</TargetName>
    <RuffleUwpRoot>$(MSBuildThisFileDirectory)..\..\..\ruffleUWP\</RuffleUwpRoot>
    <Wp80Native>$(MSBuildThisFileDirectory)..\..\wp80\RuffleWP80Native\</Wp80Native>
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAsWinRT>true</CompileAsWinRT>
      <PreprocessorDefinitions>_WINRT_DLL;WP81SL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <Optimization Condition="'$(Configuration)'=='Debug'">Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <AdditionalIncludeDirectories>$(RuffleUwpRoot)include;$(Wp80Native);$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalUsingDirectories>$(WindowsSDK_MetadataPath);$(AdditionalUsingDirectories)</AdditionalUsingDirectories>
      <DisableSpecificWarnings>4453;28204</DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <IgnoreAllDefaultLibraries>false</IgnoreAllDefaultLibraries>
      <IgnoreSpecificDefaultLibraries>ole32.lib;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
      <GenerateWindowsMetadata>true</GenerateWindowsMetadata>
      <AdditionalLibraryDirectories>$(RuffleUwpRoot)lib\ARM\release;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>ruffle_uwp.lib;ntdll_uwp.lib;ws2_32.lib;d3d11.lib;xaudio2.lib;WindowsPhoneCore.lib;RuntimeObject.lib;PhoneAppModelHost.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <FxCompile>
      <ShaderModel>4.0_level_9_1</ShaderModel>
      <ObjectFileOutput></ObjectFileOutput>
      <HeaderFileOutput>$(IntDir)Shaders\%(Filename).h</HeaderFileOutput>
      <VariableName>g_%(Filename)</VariableName>
    </FxCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="..\..\wp80\RuffleWP80Native\RuffleTest.h" />
    <ClInclude Include="..\..\wp80\RuffleWP80Native\RufflePlayer80.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="..\..\wp80\RuffleWP80Native\RuffleTest.cpp" />
    <ClCompile Include="..\..\wp80\RuffleWP80Native\RufflePlayer80.cpp" />
    <ClCompile Include="..\..\wp80\RuffleWP80Native\GpuRenderer.cpp" />
    <ClInclude Include="..\..\wp80\RuffleWP80Native\GpuRenderer.h" />
    <ClCompile Include="..\..\wp80\RuffleWP80Native\AudioOutput.cpp" />
    <ClInclude Include="..\..\wp80\RuffleWP80Native\AudioOutput.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\Common.hlsli" />
    <FxCompile Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\VS.hlsl"><ShaderType>Vertex</ShaderType></FxCompile>
    <FxCompile Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\PS_Color.hlsl"><ShaderType>Pixel</ShaderType></FxCompile>
    <FxCompile Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\PS_Linear.hlsl"><ShaderType>Pixel</ShaderType></FxCompile>
    <FxCompile Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\PS_Radial.hlsl"><ShaderType>Pixel</ShaderType></FxCompile>
    <FxCompile Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\PS_Focal.hlsl"><ShaderType>Pixel</ShaderType></FxCompile>
    <FxCompile Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\PS_Bitmap.hlsl"><ShaderType>Pixel</ShaderType></FxCompile>
    <FxCompile Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\PS_Layer.hlsl"><ShaderType>Pixel</ShaderType></FxCompile>
    <FxCompile Include="$(RuffleUwpRoot)app\RuffleUWP\Shaders\PS_LayerMask.hlsl"><ShaderType>Pixel</ShaderType></FxCompile>
    <!-- 8.1: không cần WpCompat80 (CRT VS2013 có đủ toán C99, có Fls*); PRNG qua CryptographicBuffer -->
    <ClCompile Include="..\..\shim\WpStubs.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
