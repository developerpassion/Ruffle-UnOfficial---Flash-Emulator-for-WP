<phone:PhoneApplicationPage x:Class="RuffleWP80.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    SupportedOrientations="PortraitOrLandscape" Orientation="Portrait"
    shell:SystemTray.IsVisible="False">
    <!-- Bản riêng cho Silverlight 8.1 (wp81sl).
         DrawingSurfaceBackgroundGrid phải là phần tử gốc của trang. Lõi Rust vẽ vào nền qua RufflePlayer80.
         Grid nền KHÔNG tự xoay: trang báo hướng cho native (SetOrientation), GPU xoay hình khi present.
         Chạm lấy qua Touch.FrameReported (không phụ thuộc hit-test); 2 ngón = zoom/kéo. -->
    <phone:PhoneApplicationPage.ApplicationBar>
        <!-- Chỉ hiện khi đang chơi: thanh thu nhỏ "..." ở mép, mờ để không che game -->
        <shell:ApplicationBar Mode="Minimized" Opacity="0.6" IsVisible="False">
            <shell:ApplicationBar.MenuItems>
                <shell:ApplicationBarMenuItem Text="settings" Click="OnAppBarSettings" />
                <shell:ApplicationBarMenuItem Text="reset zoom" Click="OnAppBarResetZoom" />
                <shell:ApplicationBarMenuItem Text="back to list" Click="OnAppBarBack" />
            </shell:ApplicationBar.MenuItems>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>

    <DrawingSurfaceBackgroundGrid x:Name="DrawingSurfaceBackground" SizeChanged="OnSurfaceSizeChanged">
        <!-- Danh sách SWF -->
        <Grid x:Name="menuPanel" Background="#FF1E2A44">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Ruffle" FontSize="48" Margin="24,24,24,0" Foreground="White" />
            <StackPanel Grid.Row="1" Margin="24,8,24,8">
                <TextBlock x:Name="hintText" TextWrapping="Wrap" FontSize="20" Foreground="#FFCCCCCC"
                           Text="Choose a .swf from phone storage, SD card, Downloads, Documents or OneDrive. You can also open a .swf from email or the browser." />
                <StackPanel Orientation="Horizontal">
                    <!-- File picker hệ thống đã duyệt được cả thẻ nhớ -> không cần danh sách quét SD riêng -->
                    <Button x:Name="pickButton" Content="Choose file..." Click="OnPickClick" />
                    <Button x:Name="settingsButton" Content="Settings" Click="OnSettingsClick" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- FPS (Settings > Show FPS) -->
        <TextBlock x:Name="fpsText" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8,4,0,0" FontSize="16"
                   Foreground="#FF00FF66" IsHitTestVisible="False" Visibility="Collapsed" />

        <!-- Settings (mở từ danh sách hoặc thanh app khi đang chơi) -->
        <Grid x:Name="settingsPanel" Background="#F01E2A44" Visibility="Collapsed">
            <ScrollViewer>
                <StackPanel Margin="24,24,24,24">
                    <TextBlock Text="Settings" FontSize="40" Foreground="White" Margin="0,0,0,12" />
                    <CheckBox x:Name="gpuCheck" Content="GPU rendering" Click="OnSettingChanged" />
                    <CheckBox x:Name="msaaCheck" Content="MSAA 4x anti-aliasing" Click="OnSettingChanged" />
                    <CheckBox x:Name="soundCheck" Content="Sound" Click="OnSettingChanged" />
                    <CheckBox x:Name="fpsCheck" Content="Show FPS" Click="OnSettingChanged" />
                    <!-- Bấm để đổi vòng qua các giá trị (SDK không có ComboBox/ListPicker cho WP 8.0) -->
                    <Button x:Name="scaleButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnScaleClick" />
                    <Button x:Name="qualityButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnQualityClick" />
                    <Button x:Name="limitButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnLimitClick" />
                    <TextBlock x:Name="settingsNote" TextWrapping="Wrap" FontSize="18" Foreground="#FF9AA8C8" Margin="12,8,12,0"
                               Text="Changing GPU rendering reloads the running game. Lower render resolution = smoother on large screens." />
                    <TextBlock x:Name="versionText" FontSize="18" Foreground="#FF9AA8C8" Margin="12,8,12,12" />
                    <Button Content="Close" HorizontalAlignment="Left" Click="OnSettingsClose" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DrawingSurfaceBackgroundGrid>
</phone:PhoneApplicationPage>
