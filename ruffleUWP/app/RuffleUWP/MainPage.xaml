<Page x:Class="RuffleUWP.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Black">
        <SwapChainPanel x:Name="swapChainPanel" />
        <!-- Điểm neo vô hình cho context menu (đặt Margin = vị trí chạm/chuột) -->
        <Border x:Name="menuAnchor" Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                IsHitTestVisible="False" />
        <!-- TextBox ẩn: focus vào đây để hiện bàn phím ảo; text gõ vào được chuyển cho Ruffle -->
        <TextBox x:Name="keyboardSink" Width="1" Height="1" Opacity="0" IsTabStop="False"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
        <!-- FPS overlay (Settings > Show FPS overlay) -->
        <TextBlock x:Name="fpsText" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,4,0,0"
                   FontSize="13" Foreground="#00FF66" IsHitTestVisible="False" Visibility="Collapsed" />
        <!-- Màn hình chào: nút mở SWF to ở giữa; ẩn sau khi đã nạp file (OpenFile) -->
        <StackPanel x:Name="welcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Click="OnOpenClick" HorizontalAlignment="Center" Padding="24,14"
                    Background="#37528C" Foreground="White" BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <SymbolIcon Symbol="OpenFile" Margin="0,0,12,0" />
                    <TextBlock Text="Open SWF" FontSize="22" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="welcomeSettingsButton" Click="OnWelcomeSettingsClick" HorizontalAlignment="Center"
                    Margin="0,10,0,0" Padding="16,8" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <SymbolIcon Symbol="Setting" Margin="0,0,8,0" />
                    <TextBlock Text="Settings" FontSize="16" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="errorText" Foreground="#FF6060" FontSize="13" TextWrapping="Wrap" MaxWidth="420"
                       HorizontalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed" />
            <TextBlock Text="Choose a Flash game (.swf) to play" Foreground="#AAAAAA" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>
        <!-- Neo cho popup Settings (đáy giữa màn hình). Không gắn Flyout vào AppBarButton: trong CommandBar,
             mở dropdown ComboBox làm thanh dưới đóng -> Flyout đóng theo, lựa chọn không được ghi nhận. -->
        <Border x:Name="settingsAnchor" Width="1" Height="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                IsHitTestVisible="False">
            <FlyoutBase.AttachedFlyout>
                    <Flyout x:Name="settingsFlyout">
                        <!-- Bỏ giới hạn chiều cao mặc định của Flyout; chiều cao thật do settingsScroll quyết định
                             (tính theo cửa sổ mỗi lần mở: dọc cao hơn, ngang vừa màn hình) -->
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="MaxHeight" Value="4000" />
                                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <ScrollViewer x:Name="settingsScroll" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
                        <StackPanel MinWidth="260" Margin="0,0,12,0">
                            <TextBlock Text="Settings" FontSize="20" Margin="0,0,0,8" />
                            <ToggleSwitch x:Name="gpuSwitch" Header="Hardware acceleration (GPU)" Toggled="OnSettingToggled" />
                            <ToggleSwitch x:Name="msaaSwitch" Header="MSAA 4x anti-aliasing" Toggled="OnSettingToggled" />
                            <ToggleSwitch x:Name="fpsSwitch" Header="Show FPS overlay" Toggled="OnSettingToggled" />
                            <ToggleSwitch x:Name="audioSwitch" Header="Sound" Toggled="OnSettingToggled" />
                            <ComboBox x:Name="scaleCombo" Header="Render resolution" HorizontalAlignment="Stretch"
                                      Margin="0,4,0,8" SelectionChanged="OnSettingComboChanged">
                                <ComboBoxItem Content="Auto" />
                                <ComboBoxItem Content="100%" />
                                <ComboBoxItem Content="75%" />
                                <ComboBoxItem Content="50%" />
                            </ComboBox>
                            <ComboBox x:Name="qualityCombo" Header="Quality" HorizontalAlignment="Stretch"
                                      Margin="0,0,0,8" SelectionChanged="OnSettingComboChanged">
                                <ComboBoxItem Content="Low (no bitmap smoothing)" />
                                <ComboBoxItem Content="Medium" />
                                <ComboBoxItem Content="High" />
                                <ComboBoxItem Content="Best" />
                            </ComboBox>
                            <ComboBox x:Name="limitCombo" Header="Frame limit" HorizontalAlignment="Stretch"
                                      Margin="0,0,0,8" SelectionChanged="OnSettingComboChanged">
                                <ComboBoxItem Content="Unlimited" />
                                <ComboBoxItem Content="30 FPS" />
                                <ComboBoxItem Content="20 FPS" />
                            </ComboBox>
                            <TextBlock x:Name="settingsNote" FontSize="12" Foreground="#888888" TextWrapping="Wrap" MaxWidth="260" />
                            <TextBlock x:Name="versionText" FontSize="12" Foreground="#888888" Margin="0,8,0,0" />
                        </StackPanel>
                        </ScrollViewer>
                    </Flyout>
            </FlyoutBase.AttachedFlyout>
        </Border>
    </Grid>
    <Page.BottomAppBar>
        <CommandBar x:Name="bottomBar" ClosedDisplayMode="Minimal">
            <AppBarButton Icon="OpenFile" Label="Open SWF" Click="OnOpenClick" />
            <AppBarButton Icon="Keyboard" Label="Keyboard" Click="OnKeyboardClick" />
            <AppBarButton x:Name="settingsButton" Icon="Setting" Label="Settings" Click="OnBarSettingsClick" />
        </CommandBar>
    </Page.BottomAppBar>
</Page>
